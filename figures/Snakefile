# Epitope-figure pipeline: given a query structure and/or a SAbDab summary
# TSV, produce up to three results, each carrying epitope calls in the
# B-factor column (color by B-factor in PyMOL/ChimeraX):
#
#   {tag}_groundtruth_bfactor.{ext}   query antigen, epitope-by-homology:
#                                     unioned across every training-corpus hit
#                                     >= min_seq_id
#   {tag}_prediction_bfactor.{ext}    query antigen, epiLoRA per-residue
#                                     epitope probability
#   combined_on_{ref_antigen_pdb}.cif conjoined ground truth: one reference
#                                     antigen with every surviving antibody's
#                                     Fv superposed onto it (overlaps OK),
#                                     antigen B-factors marking the union of
#                                     antibody contacts
#
# Usage:
#   snakemake --cores 4 --config input_pdb=/path/to/query.pdb
#   snakemake --cores 4 --config input_pdb=/path/to/query.cif chain=A
#   snakemake --cores 4 --config input_pdb=complex.cif "chain_groups=A|D;B|E|O;C|F|K"
#   snakemake --cores 4 --config conjoined_tsv=ebola/ebola_summary.tsv
#   snakemake --cores 4 --config input_pdb=... conjoined_tsv=...   (all three)
#
# Config (overridable via --config key=value):
#   input_pdb              .pdb or .cif query structure (omit when only
#                          building the conjoined structure)
#   chain                  single chain id, or '|'-several for a multi-chain
#                          antigen. Default: first chain in the file.
#   chain_groups           ';'-separated chain specs, one per independently-
#                          scored antigen copy in the same file.
#   outdir                 default: results/{tag}
#   train_fasta            homology-transfer corpus
#   champion_fasta         champion model's training fasta, for fold selection
#   champion_weights_glob  glob matching the champion's 5 per-fold checkpoints
#   min_seq_id / min_aln_len     identity and aligned-length floors for a hit
#                          (no coverage-ratio filter: a short-subsequence match
#                          still counts)
#   fold_avoid_min_seq_id  more lenient threshold (default 0.80) for fold
#                          selection only
#   conjoined_tsv          SAbDab summary TSV to build the conjoined ground-
#                          truth structure from (omit to skip that result)
#   structures_dir         raw SAbDab structures (<pdb>/<pdb>_sabdab.cif)
#   ref_pdb / ref_chains   reference trimer the antibodies are placed against
#   ref_antigen_pdb        PDB whose antigen every survivor is superposed onto
#   conjoined_outdir       default: results/conjoined_groundtruth
#   env_python             pipeline python (the fair-esm env by default)
import csv
import subprocess
from pathlib import Path

config.setdefault("input_pdb", None)
config.setdefault("conjoined_tsv", None)
if config["input_pdb"] is None and config["conjoined_tsv"] is None:
    raise WorkflowError("pass --config input_pdb=... and/or conjoined_tsv=...")

config.setdefault("train_fasta", "../data/results/epitopes.fasta")
config.setdefault("champion_fasta", "../data/train_test_eval/allowed_species_homo_sapiens_epitopes.fasta")
config.setdefault("champion_weights_glob", "../weights/ablation/allowed_species_homo_sapiens_fold?.pt")
config.setdefault("min_seq_id", 0.95)
config.setdefault("fold_avoid_min_seq_id", 0.80)
config.setdefault("min_aln_len", 20)
config.setdefault("db_dir", "db")
config.setdefault("env_python", "../epilora/env/bin/python3")

DB_DIR = config["db_dir"]
PY = config["env_python"]

DEFAULT_TARGETS = []


# ---------------- query-structure results ----------------
if config["input_pdb"] is not None:
    INPUT_PDB = config["input_pdb"]
    STEM = Path(INPUT_PDB).stem
    EXT = Path(INPUT_PDB).suffix.lstrip(".").lower()
    if EXT not in ("pdb", "cif"):
        raise WorkflowError(f"input_pdb must be .pdb or .cif, got {INPUT_PDB!r}")

    config.setdefault("chain", None)
    config.setdefault("chain_groups", None)
    if config["chain_groups"]:
        GROUP_SPECS = config["chain_groups"].split(";")
    else:
        chain_spec = config["chain"]
        if chain_spec is None:
            chain_spec = subprocess.run(
                [PY, "-c",
                 "import sys; sys.path.insert(0, 'scripts'); from epitope_pipeline_common import default_chain; "
                 f"print(default_chain({INPUT_PDB!r}))"],
                check=True, capture_output=True, text=True,
            ).stdout.strip()
        GROUP_SPECS = [chain_spec]

    GROUP_SLUGS = [spec.replace("|", "-") for spec in GROUP_SPECS]
    if len(set(GROUP_SLUGS)) != len(GROUP_SLUGS):
        raise WorkflowError(f"duplicate chain group among {GROUP_SPECS!r}")
    CHAIN_OF_GROUP = dict(zip(GROUP_SLUGS, GROUP_SPECS))

    # The group spec is folded into the tag so different chain/chain_groups
    # configs against the same input_pdb don't clobber each other's outputs.
    TAG = f"{STEM}_{'_'.join(GROUP_SLUGS)}"
    config.setdefault("outdir", f"results/{TAG}")
    OUTDIR = config["outdir"]
    GROUPDIR = f"{OUTDIR}/groups/{{group}}"

    CORPUS_FASTA = {"train": config["train_fasta"], "champion": config["champion_fasta"]}
    # Fold avoidance is deliberately more lenient than ground-truth transfer:
    # even a "somewhat similar" cluster is reason to route around the one
    # fold that saw it.
    MIN_SEQ_ID = {"train": config["min_seq_id"], "champion": config["fold_avoid_min_seq_id"]}

    DEFAULT_TARGETS += [
        f"{OUTDIR}/{TAG}_groundtruth_bfactor.{EXT}",
        f"{OUTDIR}/{TAG}_prediction_bfactor.{EXT}",
    ]


# ---------------- conjoined ground-truth structure ----------------
if config["conjoined_tsv"] is not None:
    config.setdefault("structures_dir", "../data/raw/all-structures-extracted")
    config.setdefault("ref_pdb", "pdb_00007kfe")
    config.setdefault("ref_chains", "A,B,C,D,E,F")
    config.setdefault("ref_antigen_pdb", "pdb_00006qd8")
    config.setdefault("conjoined_outdir", "results/conjoined_groundtruth")

    CONJOINED_TSV = config["conjoined_tsv"]
    STRUCTURES_DIR = config["structures_dir"]
    REF_PDB = config["ref_pdb"]
    REF_CHAINS = config["ref_chains"]
    REF_ANTIGEN_PDB = config["ref_antigen_pdb"]
    CONJOINED_OUTDIR = config["conjoined_outdir"]

    # Every structure the script may open: one per TSV row's PDB, plus both
    # reference structures.
    with open(CONJOINED_TSV, newline="") as f:
        conjoined_pdbs = {r["PDB"] for r in csv.DictReader(f, delimiter="\t")}
    conjoined_pdbs |= {REF_PDB, REF_ANTIGEN_PDB}
    CONJOINED_STRUCTS = sorted(f"{STRUCTURES_DIR}/{p}/{p}_sabdab.cif" for p in conjoined_pdbs)

    DEFAULT_TARGETS.append(f"{CONJOINED_OUTDIR}/combined_on_{REF_ANTIGEN_PDB}.cif")


rule all:
    input:
        DEFAULT_TARGETS


if config["input_pdb"] is not None:

    rule prepare_corpus_db:
        """Stage one training corpus for mmseqs: uppercase for search, plus a
        side JSON mapping back to its original metadata."""
        input:
            lambda wc: CORPUS_FASTA[wc.corpus]
        output:
            fasta=f"{DB_DIR}/{{corpus}}.search.fasta",
            meta=f"{DB_DIR}/{{corpus}}.meta.json",
        log:
            f"{DB_DIR}/{{corpus}}.prepare.log"
        shell:
            "{PY} scripts/0_prepare_corpus_db.py --in_fasta {input}"
            " --out_fasta {output.fasta} --out_meta {output.meta} --log {log}"

    rule mmseqs_createdb:
        """Build the mmseqs DB once per corpus; every query/group reuses it."""
        input:
            f"{DB_DIR}/{{corpus}}.search.fasta"
        output:
            f"{DB_DIR}/{{corpus}}.db.dbtype"
        log:
            f"{DB_DIR}/{{corpus}}.createdb.log"
        params:
            db=f"{DB_DIR}/{{corpus}}.db"
        shell:
            "mmseqs createdb {input} {params.db} > {log} 2>&1"

    rule homology_search:
        input:
            pdb=INPUT_PDB,
            db=f"{DB_DIR}/{{corpus}}.db.dbtype",
            meta=f"{DB_DIR}/{{corpus}}.meta.json",
        output:
            json=f"{GROUPDIR}/homology_{{corpus}}.json",
            all_hits=f"{GROUPDIR}/all_hits_{{corpus}}.json",
        log:
            f"{GROUPDIR}/logs/homology_search_{{corpus}}.log"
        params:
            chain=lambda wc: CHAIN_OF_GROUP[wc.group],
            db=f"{DB_DIR}/{{corpus}}.db",
            min_seq_id=lambda wc: MIN_SEQ_ID[wc.corpus],
            min_aln_len=config["min_aln_len"],
        shell:
            "{PY} scripts/1_homology_search.py --pdb {input.pdb} --chain '{params.chain}'"
            " --target_db {params.db} --target_meta {input.meta}"
            " --out_json {output.json} --out_all_hits {output.all_hits} --log {log}"
            " --min_seq_id {params.min_seq_id} --min_aln_len {params.min_aln_len}"

    rule groundtruth_from_homology:
        input:
            pdb=INPUT_PDB,
            all_hits=f"{GROUPDIR}/all_hits_train.json",
        output:
            f"{GROUPDIR}/groundtruth.csv"
        log:
            f"{GROUPDIR}/logs/groundtruth_from_homology.log"
        params:
            chain=lambda wc: CHAIN_OF_GROUP[wc.group]
        shell:
            "{PY} scripts/2_groundtruth_from_homology.py --pdb {input.pdb} --chain '{params.chain}'"
            " --all_hits_json {input.all_hits} --out_csv {output} --log {log}"

    rule pick_fold:
        input:
            f"{GROUPDIR}/homology_champion.json"
        output:
            f"{GROUPDIR}/fold_choice.json"
        log:
            f"{GROUPDIR}/logs/pick_fold.log"
        params:
            weights_glob=config["champion_weights_glob"]
        shell:
            "{PY} scripts/3_pick_fold.py --homology_json {input} --weights_glob '{params.weights_glob}'"
            " --out_json {output} --log {log}"

    rule predict_epitope:
        input:
            pdb=INPUT_PDB,
            fold_choice=f"{GROUPDIR}/fold_choice.json",
        output:
            f"{GROUPDIR}/prediction.csv"
        log:
            f"{GROUPDIR}/logs/predict_epitope.log"
        params:
            chain=lambda wc: CHAIN_OF_GROUP[wc.group]
        shell:
            "{PY} scripts/4_predict_epitope.py --pdb {input.pdb} --chain '{params.chain}'"
            " --fold_choice {input.fold_choice} --out_csv {output} --log {log}"

    rule combine_groundtruth_structure:
        """Merge every group's groundtruth.csv into ONE output structure."""
        input:
            pdb=INPUT_PDB,
            csvs=expand(f"{OUTDIR}/groups/{{group}}/groundtruth.csv", group=GROUP_SLUGS),
        output:
            f"{OUTDIR}/{TAG}_groundtruth_bfactor.{EXT}"
        log:
            f"{OUTDIR}/logs/combine_groundtruth_structure.log"
        params:
            pairs=lambda wc, input: " ".join(
                f"--chain '{CHAIN_OF_GROUP[g]}' --values_csv {csv}" for g, csv in zip(GROUP_SLUGS, input.csvs)
            )
        shell:
            "{PY} scripts/5_write_bfactor_structure.py --pdb {input.pdb} {params.pairs}"
            " --out {output} --log {log}"

    rule combine_prediction_structure:
        """Merge every group's prediction.csv into ONE output structure."""
        input:
            pdb=INPUT_PDB,
            csvs=expand(f"{OUTDIR}/groups/{{group}}/prediction.csv", group=GROUP_SLUGS),
        output:
            f"{OUTDIR}/{TAG}_prediction_bfactor.{EXT}"
        log:
            f"{OUTDIR}/logs/combine_prediction_structure.log"
        params:
            pairs=lambda wc, input: " ".join(
                f"--chain '{CHAIN_OF_GROUP[g]}' --values_csv {csv}" for g, csv in zip(GROUP_SLUGS, input.csvs)
            )
        shell:
            "{PY} scripts/5_write_bfactor_structure.py --pdb {input.pdb} {params.pairs}"
            " --out {output} --log {log}"


if config["conjoined_tsv"] is not None:

    rule conjoined_groundtruth_structure:
        """Build the conjoined ground-truth structure: filter the SAbDab
        summary's complexes (human antibody, placeable on the reference
        trimer without clashing, non-redundant, antigen ~reference) and write
        one reference antigen plus every survivor's Fv."""
        input:
            tsv=CONJOINED_TSV,
            structures=CONJOINED_STRUCTS,
        output:
            cif=f"{CONJOINED_OUTDIR}/combined_on_{REF_ANTIGEN_PDB}.cif",
            mapping=f"{CONJOINED_OUTDIR}/combined_on_{REF_ANTIGEN_PDB}_mapping.tsv",
        log:
            f"{CONJOINED_OUTDIR}/logs/conjoined_groundtruth_structure.log"
        params:
            structures_dir=STRUCTURES_DIR,
            out_dir=CONJOINED_OUTDIR,
            ref_pdb=REF_PDB,
            ref_chains=REF_CHAINS,
            ref_antigen_pdb=REF_ANTIGEN_PDB,
        shell:
            "{PY} scripts/6_finalize_groundtruth_structs.py {input.tsv} {params.structures_dir}"
            " {params.out_dir} {log} --ref_pdb {params.ref_pdb} --ref_chains '{params.ref_chains}'"
            " --ref_antigen_pdb {params.ref_antigen_pdb}"
